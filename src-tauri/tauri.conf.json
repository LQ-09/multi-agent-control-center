{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Control Center",
  "version": "0.11.3",
  "identifier": "dev.ling.agent-control-center",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Control Center",
        "width": 1440,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 720,
        "backgroundColor": "#ffffff"
      },
      {
        "label": "usage",
        "title": "Agent usage",
        "url": "index.html?usage",
        "width": 172,
        "height": 100,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "backgroundColor": "#00000000",
        "focus": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "resources": {
      "../build/runtime/acc-backend/": "runtime/acc-backend/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwOTRFNTI3NjZBQTUxMkMKUldRc1VhcG1KK1dVY0ZsVjVWeEZFeWVBZCtyRCtnWU5LNExJRUFqeFdLT2FVYmVBV0YzVXptZ2IK",
      "endpoints": [
        "https://github.com/LQ-09/multi-agent-control-center/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
